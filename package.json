{
  "name": "aegis-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Dota 2 desktop companion with hero stats and builds",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "dist:win": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.aegislab.desktop",
    "productName": "Aegis Lab",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "artifactName": "Aegis-Lab-${version}-portable.${ext}"
    }
  }
}
